# Environment variables declared in this file are available at build time and at run time.
# Next.js will bundle environment variables for you, only the ones prefixed with NEXT_PUBLIC_* are made available to the browser.

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/wms_db"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# HotPay.pl API
HOTPAY_API_KEY="your-hotpay-api-key"
HOTPAY_SECRET="your-hotpay-secret"
HOTPAY_ENVIRONMENT="sandbox" # or "production"

# Multi-tenant settings
ROOT_DOMAIN="localhost:3000"
ENABLE_SUBDOMAINS="true"